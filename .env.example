# NextAuth.js Configuration
# Secret key used to encrypt session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here
# Canonical URL of the application, used by NextAuth for redirects and callbacks (http://localhost:3000 in dev)
NEXTAUTH_URL=http://localhost:3000

# Supabase Configuration
# Public HTTPS URL of your Supabase instance (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Public anonymous API key safe for browser exposure (Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Elevated service role secret key for server-side admin operations (Supabase Dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Logging Configuration
# Server-side log level: debug | info | warn | error | silent (defaults to debug in dev, info in prod)
LOG_LEVEL=debug
# Browser/client-side log level: debug | info | warn | error | silent (defaults to debug in dev, info in prod)
NEXT_PUBLIC_LOG_LEVEL=debug
